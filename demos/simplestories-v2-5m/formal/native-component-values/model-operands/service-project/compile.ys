read_verilog -formal -sv -nosynthesis -D SYNTHESIS native.sv
chparam -set BANKS 4 -set ADDR_W 19 board1_verified_ddr_page_service
hierarchy -check -top board1_verified_ddr_page_service
rename -top board1_verified_ddr_page_service
proc
opt_clean
setattr -set keep 1 t:$dff t:$adff t:$dffe t:$adffe t:$sdff t:$sdffe
flatten
async2sync
opt_clean
dffunmap
memory_collect
select -assert-none t:$assume t:$assert t:$anyseq t:$anyconst
check -assert
write_json native.json
write_smt2 -wires native.smt2
