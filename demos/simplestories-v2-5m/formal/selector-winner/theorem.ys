read_verilog -formal -sv -D SYNTHESIS -D INVOCATION_CHECK -D FOLD_CHECK -D NUMERICAL_JOIN -D WATCH_ROWS selector.sv compare.sv
prep -top board1_fixed_head_argmax -flatten
async2sync
dffunmap
opt_clean
