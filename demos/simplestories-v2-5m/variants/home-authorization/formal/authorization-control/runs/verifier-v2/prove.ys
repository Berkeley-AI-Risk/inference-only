read_verilog -formal -D SYNTHESIS -sv design.sv
chparam -set USE_SHARED_HASH 1 -set MAX_MESSAGE_BYTES 128 su_lms_verify
prep -top su_lms_verify -flatten
delete su_lms_verify/shared_hash_byte_o su_lms_verify/signature_address_o su_lms_verify/message_address_o
async2sync
memory_map
opt -full
sat -verify -prove-asserts -tempinduct -tempinduct-def -seq 2 -maxsteps 6 -set clk 1 -set-at 1 reset_n 0 -set-def-inputs -show-ports -show state_q -show after_hash_q -show spec_started -dump_vcd failure.vcd
