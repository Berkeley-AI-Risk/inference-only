 endmodule
+
+// Each table keeps its own read port. The bank selection is captured on the
+// same edge as the data, so a consecutive read may change banks and an idle
+// port retains its last value. Callers keep the original address checks and
+// boot-only write gating. No RAM or read-output state is reset.
+module swic_admission_tables #(
+    parameter integer DIGEST_WORDS=14192,
+    parameter integer METADATA_WORDS=2328
+) (
+    input wire clk,
+    input wire digest_write_i,
+    input wire [13:0] digest_write_address_i,
+    input wire [31:0] digest_write_data_i,
+    input wire digest_read_i,
+    input wire [13:0] digest_read_address_i,
+    output wire [31:0] digest_read_data_o,
+    input wire metadata_write_i,
+    input wire [11:0] metadata_write_address_i,
+    input wire [191:0] metadata_write_data_i,
+    input wire metadata_read_i,
+    input wire [11:0] metadata_read_address_i,
+    output wire [191:0] metadata_read_data_o
+);
+    wire [1:0] digest_read_bank=digest_read_address_i[13:12];
+    wire [1:0] digest_write_bank=digest_write_address_i[13:12];
+    wire metadata_read_bank=metadata_read_address_i[11];
+    wire metadata_write_bank=metadata_write_address_i[11];
+    logic [1:0] digest_read_bank_q;
+    logic metadata_read_bank_q;
+    wire [31:0] digest_first,digest_middle,digest_tail;
+    wire [191:0] metadata_first,metadata_tail;
+    always_ff @(posedge clk) begin
+        if(digest_read_i) digest_read_bank_q<=digest_read_bank;
+        if(metadata_read_i) metadata_read_bank_q<=metadata_read_bank;
+    end
+    assign digest_read_data_o=!digest_read_bank_q[1] ? digest_first :
+        (digest_read_bank_q[0] ? digest_tail : digest_middle);
+    assign metadata_read_data_o=metadata_read_bank_q ? metadata_tail : metadata_first;
+
+    swic_admission_table_ram #(.WIDTH(32),.ROWS(8192)) u_digest_first (
+        .clk(clk),.write_i(digest_write_i && !digest_write_bank[1]),
+        .write_address_i(digest_write_address_i[12:0]),.write_data_i(digest_write_data_i),
+        .read_i(digest_read_i && !digest_read_bank[1]),
+        .read_address_i(digest_read_address_i[12:0]),.read_data_o(digest_first));
+    swic_admission_table_ram #(.WIDTH(32),.ROWS(4096)) u_digest_middle (
+        .clk(clk),.write_i(digest_write_i && digest_write_bank==2),
+        .write_address_i(digest_write_address_i[11:0]),.write_data_i(digest_write_data_i),
+        .read_i(digest_read_i && digest_read_bank==2),
+        .read_address_i(digest_read_address_i[11:0]),.read_data_o(digest_middle));
+    swic_admission_table_ram #(.WIDTH(32),.ROWS(DIGEST_WORDS-12288)) u_digest_tail (
+        .clk(clk),.write_i(digest_write_i && digest_write_bank==3),
+        .write_address_i(digest_write_address_i[10:0]),.write_data_i(digest_write_data_i),
+        .read_i(digest_read_i && digest_read_bank==3),
+        .read_address_i(digest_read_address_i[10:0]),.read_data_o(digest_tail));
+    swic_admission_table_ram #(.WIDTH(192),.ROWS(2048)) u_metadata_first (
+        .clk(clk),.write_i(metadata_write_i && !metadata_write_bank),
+        .write_address_i(metadata_write_address_i[10:0]),.write_data_i(metadata_write_data_i),
+        .read_i(metadata_read_i && !metadata_read_bank),
+        .read_address_i(metadata_read_address_i[10:0]),.read_data_o(metadata_first));
+    swic_admission_table_ram #(.WIDTH(192),.ROWS(METADATA_WORDS-2048)) u_metadata_tail (
+        .clk(clk),.write_i(metadata_write_i && metadata_write_bank),
+        .write_address_i(metadata_write_address_i[8:0]),.write_data_i(metadata_write_data_i),
+        .read_i(metadata_read_i && metadata_read_bank),
+        .read_address_i(metadata_read_address_i[8:0]),.read_data_o(metadata_tail));
+endmodule
+
+module swic_admission_table_ram #(
+    parameter integer WIDTH=32,
+    parameter integer ROWS=512,
+    localparam integer ADDR_BITS=$clog2(ROWS)
+) (
+    input wire clk,write_i,
+    input wire [ADDR_BITS-1:0] write_address_i,
+    input wire [WIDTH-1:0] write_data_i,
+    input wire read_i,
+    input wire [ADDR_BITS-1:0] read_address_i,
+    output logic [WIDTH-1:0] read_data_o
+);
+    (* ram_style="block" *) logic [WIDTH-1:0] words [0:ROWS-1];
+    always_ff @(posedge clk) begin
+        if(write_i) words[write_address_i]<=write_data_i;
+        if(read_i) read_data_o<=words[read_address_i];
+    end
+endmodule
 `default_nettype wire
