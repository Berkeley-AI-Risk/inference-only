(in-package "SV")
(include-book "reader-binding")
(include-book "packing")
(include-book "extent")
(local (include-book "centaur/gl/gl" :dir :system))
(local (include-book "centaur/sv/svex/gl-rules" :dir :system))
(local (gl::def-gl-clause-processor pin-wiring-glcp))
(local (gl::gl-bdd-mode))

; Meta bits 0..4 are the physical trusted clock, trusted reset_n, application
; reset_n and the two trusted-domain app-fault synchronizer registers.
; Input bits 0..2 request the next clock and reset levels. A rising clock
; holds both reset levels stable. Otherwise resets may change independently.
; A falling clock has no sensitive edge in this cone: evaluate reset changes
; at its new stationary low level. Bit 3 samples DQ1 and bit 4 samples external
; app_fault_q. Reader fault/busy are reconstructed from the old FAULT state
; and selected CS. Bits 35..59 range over old watchdog status and 60..62
; supply the FIFO synchronizer cut of the packing theorem.
(defun pin-wiring-bit (k x) (loghead 1 (logtail (nfix k) (ifix x))))
(defun pin-wiring-rise-p (meta input)
  (and (equal (pin-wiring-bit 0 meta) 0) (equal (pin-wiring-bit 0 input) 1)))
(defun pin-wiring-levels (meta input)
  (logapp 1 (ifix input)
          (loghead 2 (logtail 1 (ifix (if (pin-wiring-rise-p meta input) meta input))))))
(defun pin-wiring-event (owner extent ready meta input)
  (let* ((levels (pin-wiring-levels meta input))
         (raw (logior (if (pin-wiring-rise-p meta input) 1 0) (logand 6 levels)
                      (ash (loghead 2 (logtail 1 (ifix meta))) 3)
                      (ash (pin-wiring-bit 0 levels) 5) (if (equal (extent-state extent) 7) 64 0)
                      (if (equal (extent-cs extent) 0) 128 0)
                      (ash (loghead 2 (logtail 52 (ifix extent))) 8)
                      (ash (pin-wiring-bit 4 meta) 11)
                      (ash (loghead 25 (logtail 35 (ifix input))) 35))))
    (packing-event owner raw ready)))
(defun pin-wiring-extra (owner extent meta input)
  (logapp 1 (packing-slow-fault owner) (logapp 1 (pin-wiring-bit 3 meta)
    (logapp 1 (pin-wiring-bit 3 input) (loghead 27 (logtail 54 (ifix extent)))))))

(defconst *pin-wiring-sync-equations*
  (flash-drivers '(("app_fault_slow_sync1_q" . 1) ("app_fault_slow_sync2_q" . 1)) *stream-assigns*))
(defun pin-wiring-sync-env (stream event extra input)
  (acons (flash-prev-key "app_fault_q") (pin-wiring-bit 4 input)
         (boot-reader-fault-env stream event extra)))
(assert-event
 (let ((keys (strip-cars (pin-wiring-sync-env 0 0 0 0))))
   (and (no-duplicatesp-equal keys)
        (subsetp-equal (svexlist-vars *pin-wiring-sync-equations*) keys))))
(defun pin-wiring-raw-sync (stream event extra input)
  (let ((env (pin-wiring-sync-env stream event extra input)))
    (with-fast-alist env (svexlist-eval *pin-wiring-sync-equations* env))))
(defun pin-wiring-next-meta (stream event extra meta input)
  (let ((bits (pin-wiring-raw-sync stream event extra input)))
    (logapp 3 (pin-wiring-levels meta input) (logapp 1 (ifix (first bits)) (ifix (second bits))))))
(defun pin-wiring-step (owner extent octet ready meta input)
  (let* ((event (pin-wiring-event owner extent ready meta input))
         (extra (pin-wiring-extra owner extent meta input))
         (stream (packing-stream owner)))
    (list (logapp 60 event (logapp 8 (ifix octet) (loghead 3 (logtail 60 (ifix input)))))
          (boot-reader-first-raw stream event extra)
          (boot-reader-settle-raw stream event extra)
          (pin-wiring-next-meta stream event extra meta input))))

(defun pin-wiring-extent-microstep (extent raw)
  (if raw (extent-edge extent raw) extent))
(defun pin-wiring-extent-next (extent first settle)
  (pin-wiring-extent-microstep (pin-wiring-extent-microstep extent first) settle))
(defun pin-wiring-live-p (owner extent meta)
  (and (iff (equal (extent-cs extent) 0) (member-equal (extent-state extent) '(1 2 3)))
       (implies (extent-valid extent)
                (and (equal (extent-state extent) 2)
                     (equal (pin-wiring-bit 1 meta) 1)
                     (equal (packing-slow-fault owner) 0)
                     (equal (pin-wiring-bit 4 meta) 0)))))

(gl::def-gl-thm pin-wiring-fault-stages-follow-source
  :hyp (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 1 ready)
            (unsigned-byte-p 5 meta) (unsigned-byte-p 63 input))
  :concl
  (let* ((event (pin-wiring-event owner extent ready meta input))
         (extra (pin-wiring-extra owner extent meta input))
         (next (pin-wiring-next-meta (packing-stream owner) event extra meta input)))
    (and (equal (loghead 3 next) (pin-wiring-levels meta input))
         (equal (pin-wiring-raw-sync (packing-stream owner) event extra input)
                (list (pin-wiring-bit 3 next) (pin-wiring-bit 4 next)))
         (equal (pin-wiring-bit 3 next)
                (cond ((stream-trusted-reset-p event) 0) ((stream-rise-p event) (pin-wiring-bit 4 input))
                      (t (pin-wiring-bit 3 meta))))
         (equal (pin-wiring-bit 4 next)
                (cond ((stream-trusted-reset-p event) 0) ((stream-rise-p event) (pin-wiring-bit 3 meta))
                      (t (pin-wiring-bit 4 meta))))))
  :g-bindings (gl::auto-bindings (:nat meta 5) (:nat input 63) (:nat ready 1) (:nat owner 278) (:nat extent 81))
  :rule-classes nil)

; Check raw timing, pin identity, width, and reachable-state preservation
; with exactly the same source events as the packing and reader transitions.
(local (defconst *pin-wiring-bindings*
  (gl::auto-bindings (:nat meta 5) (:nat input 63) (:nat ready 1) (:nat owner 278)
                     (:nat extent 81) (:nat octet 8))))
(local (gl::def-gl-param-thm pin-wiring-source-spec
  :hyp (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 8 octet)
            (unsigned-byte-p 1 ready) (unsigned-byte-p 5 meta) (unsigned-byte-p 63 input))
  :concl
  (let* ((w (pin-wiring-step owner extent octet ready meta input))
         (pkt (first w)) (first (second w)) (settle (third w)) (new-meta (fourth w))
         (event (packet-event pkt)) (pins (packing-spec-pins owner event ready octet))
         (new-owner (packing-spec-edge owner event ready octet))
         (end (pin-wiring-extent-next extent first settle)))
    (and (unsigned-byte-p 71 pkt) (unsigned-byte-p 60 event) (unsigned-byte-p 5 new-meta)
         (or (not first) (unsigned-byte-p 35 first))
         (or (not settle) (and (unsigned-byte-p 35 settle) (logbitp 33 settle)))
         (unsigned-byte-p 81 end)
         (equal (packet-data pkt) octet) (equal (nth 2 pins) octet)
         (equal (packet-gray pkt) (loghead 3 (logtail 60 (ifix input))))
         (iff (stream-rise-p event) (pin-wiring-rise-p meta input))
         (equal (stream-current-trusted-reset-n event) (pin-wiring-bit 1 new-meta))
         (equal (stream-current-app-reset-n event) (pin-wiring-bit 2 new-meta))
         (implies (and first (not (logbitp 33 first)))
                  (and (stream-rise-p event) (equal (pin-wiring-bit 3 first) (pin-wiring-bit 3 input))))
         (implies (pin-wiring-live-p owner extent meta)
                  (and (iff (packet-accept-p pins event) (extent-takep extent first))
                       (pin-wiring-live-p new-owner end new-meta)))
         (implies (and (equal meta 0) (equal input 1))
                  (and (stream-trusted-reset-p event) first (not (logbitp 33 first)) (not (logbitp 0 first))
                       (not settle) (not (extent-takep extent first)) (not (packet-accept-p pins event))
                       (equal new-meta 1) (pin-wiring-live-p new-owner end new-meta)))))
  :param-hyp (let ((w (pin-wiring-step owner extent octet ready meta input)))
               (and (iff (second w) firstp) (iff (third w) settlep)))
  :param-bindings `((((firstp nil) (settlep nil)) ,*pin-wiring-bindings*)
                    (((firstp t)   (settlep nil)) ,*pin-wiring-bindings*)
                    (((firstp nil) (settlep t))   ,*pin-wiring-bindings*)
                    (((firstp t)   (settlep t))   ,*pin-wiring-bindings*))
  :cov-bindings *pin-wiring-bindings*
  :rule-classes nil))

(defthm pin-wiring-source-step-law
  (implies (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 8 octet)
                (unsigned-byte-p 1 ready) (unsigned-byte-p 5 meta) (unsigned-byte-p 63 input))
    (let* ((w (pin-wiring-step owner extent octet ready meta input))
           (pkt (first w)) (first (second w)) (settle (third w)) (new-meta (fourth w))
           (event (packet-event pkt)) (pins (packing-pins owner event ready octet))
           (new-owner (packing-edge owner event ready octet))
           (end (pin-wiring-extent-next extent first settle)))
      (and (unsigned-byte-p 71 pkt) (unsigned-byte-p 60 event) (unsigned-byte-p 5 new-meta)
           (or (not first) (unsigned-byte-p 35 first))
           (or (not settle) (and (unsigned-byte-p 35 settle) (logbitp 33 settle)))
           (unsigned-byte-p 81 end)
           (equal (packet-data pkt) octet) (equal (nth 2 pins) octet)
           (equal (packet-gray pkt) (loghead 3 (logtail 60 (ifix input))))
           (iff (stream-rise-p event) (pin-wiring-rise-p meta input))
           (equal (stream-current-trusted-reset-n event) (pin-wiring-bit 1 new-meta))
           (equal (stream-current-app-reset-n event) (pin-wiring-bit 2 new-meta))
           (implies (and first (not (logbitp 33 first)))
                    (and (stream-rise-p event) (equal (pin-wiring-bit 3 first) (pin-wiring-bit 3 input))))
           (implies (pin-wiring-live-p owner extent meta)
                    (and (iff (packet-accept-p pins event) (extent-takep extent first))
                         (pin-wiring-live-p new-owner end new-meta)))
           (implies (and (equal meta 0) (equal input 1))
                    (and (stream-trusted-reset-p event) first (not (logbitp 33 first)) (not (logbitp 0 first))
                         (not settle) (not (extent-takep extent first)) (not (packet-accept-p pins event))
                         (equal new-meta 1) (pin-wiring-live-p new-owner end new-meta))))))
  :hints (("Goal" :use (pin-wiring-source-spec
                        (:instance packing-source-step-law (old owner)
                            (event (packet-event (first (pin-wiring-step owner extent octet ready meta input))))
                            (fifo-ready ready) (data octet))) :in-theory nil))
  :rule-classes nil)

(defthm pin-wiring-common-reset-law
  (implies (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 8 octet)
                (unsigned-byte-p 1 ready))
    (let* ((w (pin-wiring-step owner extent octet ready 0 1))
           (pkt (first w)) (first (second w)) (settle (third w)) (new-meta (fourth w))
           (event (packet-event pkt)) (pins (packing-pins owner event ready octet)))
      (and (stream-trusted-reset-p event) (unsigned-byte-p 71 pkt) (equal (packet-data pkt) octet)
           first (unsigned-byte-p 35 first) (not (logbitp 33 first)) (not (logbitp 0 first))
           (not settle) (not (extent-takep extent first)) (not (packet-accept-p pins event))
           (equal new-meta 1)
           (pin-wiring-live-p (packing-edge owner event ready octet)
                              (pin-wiring-extent-next extent first settle) new-meta))))
  :hints (("Goal" :use ((:instance pin-wiring-source-step-law (meta 0) (input 1)))
           :in-theory '((:executable-counterpart unsigned-byte-p))))
  :rule-classes nil)

(local (gl::def-gl-thm pin-wiring-ready-width
  :hyp (unsigned-byte-p 1 full)
  :concl (unsigned-byte-p 1 (fifo-write-ready full))
  :g-bindings (gl::auto-bindings (:nat full 1)) :rule-classes nil))

(defthm pin-wiring-packet-step-law
  (implies (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 8 octet)
                (unsigned-byte-p 1 full) (unsigned-byte-p 5 meta) (unsigned-byte-p 63 input))
    (let* ((ready (fifo-write-ready full))
           (w (pin-wiring-step owner extent octet ready meta input))
           (pkt (first w)) (first (second w)) (settle (third w)) (new-meta (fourth w))
           (transaction (packet-step owner pointer full memory pkt)) (row (nth 4 transaction)))
      (and (unsigned-byte-p 1 ready) (unsigned-byte-p 71 pkt)
           (or (not first) (unsigned-byte-p 35 first))
           (or (not settle) (and (unsigned-byte-p 35 settle) (logbitp 33 settle)))
           (unsigned-byte-p 5 new-meta)
           (equal (nth 0 row) (stream-trusted-reset-p (packet-event pkt))) (equal (nth 2 row) octet)
           (implies (pin-wiring-live-p owner extent meta)
                    (and (iff (nth 1 row) (extent-takep extent first))
                         (pin-wiring-live-p (nth 0 transaction)
                                            (pin-wiring-extent-next extent first settle) new-meta)))
           (implies (and (equal meta 0) (equal input 1))
                    (and (nth 0 row) (not (nth 1 row))
                         (pin-wiring-live-p (nth 0 transaction)
                                            (pin-wiring-extent-next extent first settle) new-meta))))))
  :hints (("Goal" :use (pin-wiring-ready-width
                        (:instance pin-wiring-source-step-law (ready (fifo-write-ready full))))
           :in-theory '(packet-step packet-observation nth (:executable-counterpart zp)
                        (:executable-counterpart binary-+) car-cons cdr-cons)))
  :rule-classes nil)

; The reader's post-NBA reset on one event is the old reset of the next
; event: both use the same stored fault stages, parent slow fault and levels.
(local (gl::def-gl-thm pin-wiring-reset-spec
  :hyp (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 8 octet)
            (unsigned-byte-p 1 ready) (unsigned-byte-p 5 meta) (unsigned-byte-p 63 input))
  :concl
  (let* ((event (pin-wiring-event owner extent ready meta input))
         (extra (pin-wiring-extra owner extent meta input)) (s (packing-stream owner))
         (next-meta (pin-wiring-next-meta s event extra meta input))
         (new-owner (packing-spec-edge owner event ready octet)))
    (and (unsigned-byte-p 60 event)
         (equal (pin-wiring-bit 6 event) (if (equal (extent-state extent) 7) 1 0))
         (equal (pin-wiring-bit 7 event) (if (equal (extent-cs extent) 0) 1 0))
         (equal (pin-wiring-bit 8 event) (if (extent-valid extent) 1 0))
         (equal (pin-wiring-bit 9 event) (if (extent-last extent) 1 0))
         (equal (boot-reader-old-reset-n event extra)
                (boot-reader-reset-n (pin-wiring-bit 1 meta) (packing-slow-fault owner) (pin-wiring-bit 4 meta)))
         (equal (boot-reader-pre-reset-n event extra)
                (boot-reader-reset-n (pin-wiring-bit 1 next-meta) (packing-slow-fault owner) (pin-wiring-bit 4 meta)))
         (equal (boot-reader-post-reset-n s event extra)
                (boot-reader-reset-n (pin-wiring-bit 1 next-meta)
                                     (packing-slow-fault new-owner) (pin-wiring-bit 4 next-meta)))))
  :g-bindings (gl::auto-bindings (:nat meta 5) (:nat input 63) (:nat ready 1) (:nat owner 278)
                                 (:nat extent 81) (:nat octet 8))
  :rule-classes nil))

(defthm pin-wiring-reader-status-and-reset-continuity
  (implies (and (unsigned-byte-p 278 owner) (unsigned-byte-p 81 extent) (unsigned-byte-p 8 octet)
                (unsigned-byte-p 1 ready) (unsigned-byte-p 5 meta) (unsigned-byte-p 63 input))
    (let* ((event (pin-wiring-event owner extent ready meta input))
           (extra (pin-wiring-extra owner extent meta input)) (s (packing-stream owner))
           (next-meta (pin-wiring-next-meta s event extra meta input))
           (new-owner (packing-edge owner event ready octet)))
      (and (equal (pin-wiring-bit 6 event) (if (equal (extent-state extent) 7) 1 0))
           (equal (pin-wiring-bit 7 event) (if (equal (extent-cs extent) 0) 1 0))
           (equal (pin-wiring-bit 8 event) (if (extent-valid extent) 1 0))
           (equal (pin-wiring-bit 9 event) (if (extent-last extent) 1 0))
           (equal (boot-reader-old-reset-n event extra)
                  (boot-reader-reset-n (pin-wiring-bit 1 meta) (packing-slow-fault owner) (pin-wiring-bit 4 meta)))
           (equal (boot-reader-pre-reset-n event extra)
                  (boot-reader-reset-n (pin-wiring-bit 1 next-meta) (packing-slow-fault owner) (pin-wiring-bit 4 meta)))
           (equal (boot-reader-post-reset-n s event extra)
                  (boot-reader-reset-n (pin-wiring-bit 1 next-meta)
                                       (packing-slow-fault new-owner) (pin-wiring-bit 4 next-meta))))))
  :hints (("Goal" :use (pin-wiring-reset-spec
                        (:instance packing-source-step-law (old owner) (fifo-ready ready) (data octet)
                                   (event (pin-wiring-event owner extent ready meta input)))) :in-theory nil))
  :rule-classes nil)
